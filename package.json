{
  "name": "rehat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run swagger:assets && next dev",
    "build": "prisma generate && bun run openapi && bun run swagger:assets && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:sql": "bun scripts/apply-supabase-sql.ts",
    "db:studio": "prisma studio",
    "seed": "bun prisma/seed.ts",
    "openapi": "bun scripts/generate-openapi.ts",
    "swagger:assets": "bun scripts/copy-swagger-assets.ts",
    "smoke": "bun scripts/smoke.ts",
    "cron:expire": "bun scripts/cron-expire.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit tests/api",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:db:setup": "bun scripts/setup-test-db.ts",
    "test:e2e": "playwright test",
    "test:all": "bun run test && bun run test:e2e",
    "load:test": "bun scripts/load-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "midtrans-client": "^1.4.3",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "swagger-ui-dist": "^5.34.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/midtrans-client": "^1.4.0",
    "@types/node": "24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "dotenv": "^18.0.9",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}
