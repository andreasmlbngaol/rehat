# Application
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
BOOKING_PAYMENT_TTL_MINUTES="60"

# Operasional
# Dipakai Vercel Cron untuk mengirim Authorization: Bearer <CRON_SECRET>.
CRON_SECRET="[random-secret]"
# Opsional: endpoint webhook untuk menerima laporan error server (Sentry, dll).
ERROR_REPORT_WEBHOOK_URL=""

# PostgreSQL (Supabase)
# Use the Supabase connection string for the environment you are targeting.
DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Supabase Auth and Realtime
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# Midtrans (sandbox)
MIDTRANS_MERCHANT_ID="[merchant-id]"
MIDTRANS_SERVER_KEY="[server-key]"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="[client-key]"
MIDTRANS_IS_PRODUCTION="false"

# Zoom Server-to-Server OAuth
ZOOM_ACCOUNT_ID="[account-id]"
ZOOM_CLIENT_ID="[client-id]"
ZOOM_CLIENT_SECRET="[client-secret]"

# Resend
RESEND_API_KEY="re_[api-key]"
RESEND_FROM_EMAIL="REHAT <no-reply@example.com>"
# Secret untuk Supabase Auth Send Email Hook (opsional bila memakai SMTP).
SUPABASE_SEND_EMAIL_HOOK_SECRET="v1,whsec_[hook-secret]"

# Cloudflare R2
R2_ACCOUNT_ID="[account-id]"
R2_ACCESS_KEY_ID="[access-key-id]"
R2_SECRET_ACCESS_KEY="[secret-access-key]"
R2_BUCKET_NAME="rehat-avatars"
R2_ENDPOINT="https://[account-id].r2.cloudflarestorage.com"
R2_PUBLIC_URL="https://[public-bucket-domain]"

# Seed admin (hanya dipakai `bun run seed`, jangan di-commit).
# Seed hanya membuat akun admin. Layanan dan konselor dibuat lewat dashboard admin.
SEED_ADMIN_EMAIL="admin@rehat.com"
SEED_ADMIN_PASSWORD="[strong-password]"

# Pengujian
# Database terpisah untuk integration test. Nama database wajib mengandung
# "test" agar `resetDatabase()` menolak menghapus data database lain.
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/rehat_test"

# E2E (Playwright). Kosongkan untuk melewati test yang membutuhkan akun.
E2E_BASE_URL="http://localhost:3000"
E2E_PATIENT_EMAIL=""
E2E_PATIENT_PASSWORD=""
E2E_COUNSELOR_EMAIL=""
E2E_COUNSELOR_PASSWORD=""
E2E_ADMIN_EMAIL=""
E2E_ADMIN_PASSWORD=""
# Set true untuk menguji Snap (butuh kredensial Midtrans sandbox yang valid).
E2E_PAYMENT="false"
# Set 1 untuk memakai ulang state login di tests/e2e/.auth (tanpa login ulang).
E2E_SKIP_GLOBAL_SETUP=""
