// Skema data REHAT - mengacu pada SRS §4.1 dan §4.2.
// Semua waktu disimpan sebagai timestamptz (UTC).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  patient
  counselor
  admin
}

enum CounselingMethod {
  chat
  zoom
}

enum TimeSlotStatus {
  available
  held
  booked
}

enum BookingStatus {
  pending_payment
  confirmed
  cancelled
  expired
}

enum PaymentStatus {
  pending
  success
  failed
  cancelled
  expired
}

enum SessionStatus {
  scheduled
  active
  completed
}

enum ZoomIntegrationStatus {
  pending
  created
  failed
}

model Profile {
  id        String   @id @db.Uuid
  fullName  String   @map("full_name")
  email     String   @unique
  role      UserRole @default(patient)
  avatarKey String?  @map("avatar_key")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  counselorProfile    CounselorProfile?
  bookingsAsPatient   Booking[]         @relation("BookingPatient")
  bookingsAsCounselor Booking[]         @relation("BookingCounselor")
  timeSlots           TimeSlot[]        @relation("TimeSlotCounselor")
  createdTimeSlots    TimeSlot[]        @relation("TimeSlotCreator")
  chatMessages        ChatMessage[]
  counselorServices   CounselorService[]

  @@index([role, isActive])
  @@map("profiles")
}

model CounselorProfile {
  counselorId    String   @id @map("counselor_id") @db.Uuid
  specialization String
  bio            String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  counselor Profile @relation(fields: [counselorId], references: [id], onDelete: Cascade)

  @@map("counselor_profiles")
}

model Service {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  description     String   @db.Text
  durationMinutes Int      @map("duration_minutes")
  price           Decimal  @db.Decimal(12, 2)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  methods    ServiceMethod[]
  counselors CounselorService[]
  bookings   Booking[]

  @@index([isActive])
  @@map("services")
}

model ServiceMethod {
  serviceId String           @map("service_id") @db.Uuid
  method    CounselingMethod

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([serviceId, method])
  @@map("service_methods")
}

model CounselorService {
  counselorId String @map("counselor_id") @db.Uuid
  serviceId   String @map("service_id") @db.Uuid

  counselor Profile @relation(fields: [counselorId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([counselorId, serviceId])
  @@index([serviceId])
  @@map("counselor_services")
}

model TimeSlot {
  id          String         @id @default(uuid()) @db.Uuid
  counselorId String         @map("counselor_id") @db.Uuid
  createdBy   String         @map("created_by") @db.Uuid
  startTime   DateTime       @map("start_time") @db.Timestamptz(3)
  endTime     DateTime       @map("end_time") @db.Timestamptz(3)
  status      TimeSlotStatus @default(available)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  counselor Profile @relation("TimeSlotCounselor", fields: [counselorId], references: [id])
  creator   Profile @relation("TimeSlotCreator", fields: [createdBy], references: [id])
  bookings  Booking[]

  @@index([counselorId, startTime])
  @@index([status, startTime])
  @@map("time_slots")
}

model Booking {
  id               String           @id @default(uuid()) @db.Uuid
  bookingCode      String           @unique @map("booking_code")
  patientId        String           @map("patient_id") @db.Uuid
  counselorId      String           @map("counselor_id") @db.Uuid
  serviceId        String           @map("service_id") @db.Uuid
  timeSlotId       String           @map("time_slot_id") @db.Uuid
  method           CounselingMethod
  status           BookingStatus    @default(pending_payment)
  paymentExpiresAt DateTime?        @map("payment_expires_at") @db.Timestamptz(3)
  idempotencyKey   String           @unique @map("idempotency_key") @db.Uuid
  serviceName      String           @map("service_name")
  durationMinutes  Int              @map("duration_minutes")
  price            Decimal          @db.Decimal(12, 2)
  scheduledStart   DateTime         @map("scheduled_start") @db.Timestamptz(3)
  scheduledEnd     DateTime         @map("scheduled_end") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient   Profile            @relation("BookingPatient", fields: [patientId], references: [id])
  counselor Profile            @relation("BookingCounselor", fields: [counselorId], references: [id])
  service   Service            @relation(fields: [serviceId], references: [id])
  timeSlot  TimeSlot           @relation(fields: [timeSlotId], references: [id])
  payments  Payment[]
  session   CounselingSession?

  @@index([patientId, createdAt])
  @@index([counselorId, scheduledStart])
  @@index([status, paymentExpiresAt])
  @@map("bookings")
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  bookingId             String        @map("booking_id") @db.Uuid
  midtransOrderId       String        @unique @map("midtrans_order_id")
  snapToken             String?       @map("snap_token")
  midtransTransactionId String?       @map("midtrans_transaction_id")
  grossAmount           Decimal       @map("gross_amount") @db.Decimal(12, 2)
  paymentType           String?       @map("payment_type")
  status                PaymentStatus @default(pending)
  transactionTime       DateTime?     @map("transaction_time") @db.Timestamptz(3)
  expiresAt             DateTime?     @map("expires_at") @db.Timestamptz(3)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking       Booking               @relation(fields: [bookingId], references: [id])
  webhookEvents PaymentWebhookEvent[]

  @@index([bookingId, status])
  @@map("payments")
}

model PaymentWebhookEvent {
  id                String    @id @default(uuid()) @db.Uuid
  paymentId         String?   @map("payment_id") @db.Uuid
  midtransOrderId   String    @map("midtrans_order_id")
  transactionStatus String?   @map("transaction_status")
  signatureValid    Boolean   @map("signature_valid")
  rawPayload        Json      @map("raw_payload")
  eventHash         String    @unique @map("event_hash")
  processedAt       DateTime? @map("processed_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([midtransOrderId])
  @@map("payment_webhook_events")
}

model CounselingSession {
  id        String        @id @default(uuid()) @db.Uuid
  bookingId String        @unique @map("booking_id") @db.Uuid
  status    SessionStatus @default(scheduled)
  startedAt DateTime?     @map("started_at") @db.Timestamptz(3)
  endedAt   DateTime?     @map("ended_at") @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking     Booking       @relation(fields: [bookingId], references: [id])
  messages    ChatMessage[]
  zoomMeeting ZoomMeeting?

  @@index([status])
  @@map("counseling_sessions")
}

model ChatMessage {
  id              String   @id @default(uuid()) @db.Uuid
  sessionId       String   @map("session_id") @db.Uuid
  senderId        String   @map("sender_id") @db.Uuid
  content         String   @db.Text
  clientMessageId String   @map("client_message_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  session CounselingSession @relation(fields: [sessionId], references: [id])
  sender  Profile           @relation(fields: [senderId], references: [id])

  @@unique([sessionId, clientMessageId])
  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model ZoomMeeting {
  id                String                @id @default(uuid()) @db.Uuid
  sessionId         String                @unique @map("session_id") @db.Uuid
  zoomMeetingId     String?               @map("zoom_meeting_id")
  joinUrl           String?               @map("join_url")
  startUrl          String?               @map("start_url")
  startTime         DateTime              @map("start_time") @db.Timestamptz(3)
  durationMinutes   Int                   @map("duration_minutes")
  integrationStatus ZoomIntegrationStatus @default(pending) @map("integration_status")
  attemptCount      Int                   @default(0) @map("attempt_count")
  lastError         String?               @map("last_error") @db.Text
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  session CounselingSession @relation(fields: [sessionId], references: [id])

  @@map("zoom_meetings")
}
